# ──────────────────────────────────────────────────────────────────────────────
# FINOVA Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local
# ──────────────────────────────────────────────────────────────────────────────

# ── API URL ─────────────────────────────────────────────────────────────────────
# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (set in Vercel dashboard or via vercel CLI):
NEXT_PUBLIC_API_URL=https://your-finova-backend.vercel.app/api
