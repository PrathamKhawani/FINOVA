# ── API URL ─────────────────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (replace with your deployed backend URL):
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api
