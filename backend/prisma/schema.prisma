// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  statements    BankStatement[]
  refreshTokens RefreshToken[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  loans         Loan[]
  categorizationRules UserCategorizationRule[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankStatement {
  id           String        @id @default(cuid())
  userId       String
  source       String        @default("BANK")   // "BANK" | "WALLET"
  provider     String?                           // "HDFC" | "PhonePe" | "Paytm" etc.
  bankName     String?
  fileName     String
  originalName String
  period       String?
  totalCredits Float         @default(0)
  totalDebits  Float         @default(0)
  uploadedAt   DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id              String        @id @default(cuid())
  statementId     String
  date            DateTime
  description     String
  rawNarration    String?
  merchantName    String?
  counterparty    String?
  // paymentChannel: HOW the money moved (UPI/NEFT/IMPS/ATM/Card etc.) — separate from statementSource
  channel         String?
  amount          Float
  debit           Float?
  credit          Float?
  type            String        // "credit" | "debit"
  transactionType String?       // "Income" | "Expense" | "Transfer" | "Refund"
  // statementSource: WHERE the statement came from ("BANK" | "WALLET")
  source          String        @default("BANK")
  // provider: Which bank / wallet produced this statement ("HDFC" | "PhonePe" | "Paytm" etc.)
  provider        String?
  category        String
  subcategory     String?
  confidence      String?       // "high" | "medium" | "low"
  referenceId     String?
  // Additional extracted fields preserved verbatim from source
  time            String?       // HH:MM or HH:MM:SS from source
  upiId           String?       // UPI VPA (e.g. merchant@upi)
  orderId         String?       // Order ID from wallet statements
  notes           String?       // Notes/remarks field from CSV/wallet
  linkedAccount   String?       // Bank account / wallet account used
  balance         Float?
  isDuplicate     Boolean       @default(false)
  duplicateOf     String?       // ID of the transaction this might duplicate
  needsReview     Boolean       @default(false)
  classificationReason String?  // WHY this category was assigned
  entityType           String?  // 'Known Merchant' | 'Known Person' | 'Known Financial Institution' | etc.
  businessType         String?  // 'Quick Commerce' | 'Food Delivery' | 'Cab Aggregator' | etc.
  legalName            String?  // Registered legal name of the entity
  parentCompany        String?  // Holding company if different from brand
  extractedVPA         String?  // Extracted UPI VPA from the narration
  matchedAlias         String?  // Which alias triggered the KB match
  // User Review Override — NEVER modifies raw financial values
  userCategory         String?  // User-selected category (overrides auto category for display)
  userSubcategory      String?  // User-selected subcategory
  userNote             String?  // User's comment on this transaction
  reviewedAt           DateTime? // When the user last reviewed/corrected this
  appliedRuleId        String?  // ID of UserCategorizationRule that classified this
  createdAt       DateTime      @default(now())
  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  appliedRule     UserCategorizationRule? @relation(fields: [appliedRuleId], references: [id], onDelete: SetNull)
}

// ── Budget Management ─────────────────────────────────────────────────────────
model Budget {
  id         String   @id @default(cuid())
  userId     String
  category   String
  subcategory String?
  monthYear  String   // "2025-08" format
  limitAmount Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Savings Goals ─────────────────────────────────────────────────────────────
model SavingsGoal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  targetDate   DateTime?
  emoji        String?  @default("🎯")
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── User Categorization Rules ─────────────────────────────────────────────────
// Stores user-defined rules to auto-classify future matching transactions.
// Rules are applied BEFORE generic auto-categorization.
// Raw financial values (amount, date, narration) are NEVER modified.
model UserCategorizationRule {
  id              String    @id @default(cuid())
  userId          String
  name            String    // Human-readable rule name e.g. "ABC Services → Business Income"
  // Matching signals (all must match when set)
  matchNarration  String?   // Normalized narration substring to match
  matchMerchant   String?   // Merchant/counterparty name to match
  matchVPA        String?   // UPI VPA to match
  matchDirection  String?   // "credit" | "debit" | null (any)
  matchPaymentType String?  // "UPI" | "NEFT" | "IMPS" | null (any)
  // Target classification
  category        String
  subcategory     String?
  // Rule meta
  isEnabled       Boolean   @default(true)
  priority        Int       @default(0)  // Higher = checked first
  appliedCount    Int       @default(0)  // How many txns this rule has auto-classified
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
}

// ── Loan & EMI Tracker ────────────────────────────────────────────────────────
model Loan {
  id              String   @id @default(cuid())
  userId          String
  name            String
  lenderName      String?
  principalAmount Float
  outstandingAmount Float
  emiAmount       Float
  interestRate    Float?
  tenureMonths    Int?
  startDate       DateTime?
  nextDueDate     DateTime?
  loanType        String   @default("Personal") // "Home" | "Car" | "Personal" | "Education" | "Business"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
