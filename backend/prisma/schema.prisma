// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  statements    BankStatement[]
  refreshTokens RefreshToken[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  loans         Loan[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankStatement {
  id           String        @id @default(cuid())
  userId       String
  source       String        @default("BANK")   // "BANK" | "WALLET"
  provider     String?                           // "HDFC" | "PhonePe" | "Paytm" etc.
  bankName     String?
  fileName     String
  originalName String
  period       String?
  totalCredits Float         @default(0)
  totalDebits  Float         @default(0)
  uploadedAt   DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id              String        @id @default(cuid())
  statementId     String
  date            DateTime
  description     String
  rawNarration    String?
  merchantName    String?
  counterparty    String?
  channel         String?
  amount          Float
  debit           Float?
  credit          Float?
  type            String        // "credit" | "debit"
  transactionType String?       // "Income" | "Expense" | "Transfer" | "Refund"
  source          String        @default("BANK")   // "BANK" | "WALLET"
  provider        String?                           // "HDFC" | "PhonePe" | "Paytm" etc.
  category        String
  subcategory     String?
  confidence      String?       // "high" | "medium" | "low"
  referenceId     String?
  balance         Float?
  isDuplicate     Boolean       @default(false)
  duplicateOf     String?       // ID of the transaction this might duplicate
  needsReview     Boolean       @default(false)
  classificationReason String?  // WHY this category was assigned
  createdAt       DateTime      @default(now())
  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
}

// ── Budget Management ─────────────────────────────────────────────────────────
model Budget {
  id         String   @id @default(cuid())
  userId     String
  category   String
  subcategory String?
  monthYear  String   // "2025-08" format
  limitAmount Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Savings Goals ─────────────────────────────────────────────────────────────
model SavingsGoal {
  id           String   @id @default(cuid())
  userId       String
  name         String
  targetAmount Float
  savedAmount  Float    @default(0)
  targetDate   DateTime?
  emoji        String?  @default("🎯")
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Loan & EMI Tracker ────────────────────────────────────────────────────────
model Loan {
  id              String   @id @default(cuid())
  userId          String
  name            String
  lenderName      String?
  principalAmount Float
  outstandingAmount Float
  emiAmount       Float
  interestRate    Float?
  tenureMonths    Int?
  startDate       DateTime?
  nextDueDate     DateTime?
  loanType        String   @default("Personal") // "Home" | "Car" | "Personal" | "Education" | "Business"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
