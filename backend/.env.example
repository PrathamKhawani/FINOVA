# ──────────────────────────────────────────────────────────────────────────────
# FINOVA Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it contains secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (local dev — no server needed):
# DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production — Neon, Railway, Supabase, etc.):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/finova?schema=public&sslmode=require"

# ── JWT Secrets (use long random strings in production) ────────────────────────
JWT_ACCESS_SECRET="replace_with_a_long_random_string_in_production"
JWT_REFRESH_SECRET="replace_with_another_long_random_string_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS — comma-separated list of allowed frontend origins ────────────────────
# Include both localhost (local dev) and your deployed frontend URL
CORS_ORIGIN="http://localhost:3000,https://your-finova-frontend.vercel.app"

# ── File Uploads ───────────────────────────────────────────────────────────────
# Not used in production (memoryStorage); retained for local dev compatibility
UPLOAD_DIR="uploads"
